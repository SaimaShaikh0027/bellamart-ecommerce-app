@model List<bellamart_ecommerce_app.Models.Order>
@{
    ViewData["Title"] = "My Orders";
}

<section class="storefront">
    <div class="storefront__announcement">Your order history <span>•</span> Every good find, in one place</div>
    <div class="storefront__nav">
        <a class="brand" asp-controller="Product" asp-action="Index"><span class="brand__mark">b</span><span>bella<span class="brand__accent">mart</span></span></a>
        <nav class="storefront__links" aria-label="Main navigation"><a asp-controller="Product" asp-action="Index">Shop</a><a asp-controller="Wishlist" asp-action="Index">♡ Wishlist</a><a class="active" asp-action="Index">My Orders</a></nav>
        <div class="storefront__actions"><a class="back-link" asp-controller="Product" asp-action="Index">← Continue shopping</a></div>
    </div>

    <main class="orders-page">
        <div class="section-heading orders-heading"><div><p class="eyebrow">Your purchases</p><h1>My Orders</h1></div><span class="product-count">@Model.Count orders</span></div>
        @if (Model.Count == 0)
        {
            <div class="cart-empty"><h2>No orders yet.</h2><p>Your next favorite thing is waiting in the collection.</p><a class="button button--dark" asp-controller="Product" asp-action="Index">Start shopping <span>→</span></a></div>
        }
        else
        {
            <div class="order-list">
                @foreach (var order in Model.OrderByDescending(item => item.PlacedAt))
                {
                    <article class="order-card"><div class="order-card__top"><div><p class="eyebrow">Order #@order.OrderNumber</p><p class="order-card__date">Placed @order.PlacedAt.ToString("dd MMM yyyy")</p></div><span class="order-status">Confirmed</span></div><div class="order-card__items">@foreach (var item in order.Items) { <span>@item.Product.Name × @item.Quantity</span> }</div><div class="order-card__bottom"><span>@order.PaymentMethod</span><strong>₹@order.Total.ToString("N0")</strong></div></article>
                }
            </div>
        }
    </main>
</section>
