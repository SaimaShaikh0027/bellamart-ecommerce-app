@model bellamart_ecommerce_app.Models.Product
@{
    ViewData["Title"] = Model.Id == 0 ? "Add Product" : "Edit Product";
    var action = Model.Id == 0 ? "Create" : "Edit";
}

<section class="admin-page"><header class="admin-header"><a class="brand" asp-controller="Product" asp-action="Index"><span class="brand__mark">b</span><span>bella<span class="brand__accent">mart</span></span></a><a class="admin-link" asp-action="Index">← Back to products</a></header><div class="admin-title"><div><p class="eyebrow">Catalog management</p><h1>@ViewData["Title"]</h1></div></div><form asp-action="@action" method="post" class="admin-form"><div asp-validation-summary="ModelOnly" class="validation-message"></div><input asp-for="Id" type="hidden" /><div class="admin-form__grid"><div><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="validation-message"></span></div><div><label asp-for="Category"></label><input asp-for="Category" /><span asp-validation-for="Category" class="validation-message"></span></div><div><label asp-for="Price"></label><input asp-for="Price" type="number" min="0" step="1" /><span asp-validation-for="Price" class="validation-message"></span></div><div><label asp-for="Stock"></label><input asp-for="Stock" type="number" min="0" /><span asp-validation-for="Stock" class="validation-message"></span></div><div class="admin-form__wide"><label asp-for="ImageUrl"></label><input asp-for="ImageUrl" /><span asp-validation-for="ImageUrl" class="validation-message"></span></div><div class="admin-form__wide"><label asp-for="Description"></label><textarea asp-for="Description"></textarea><span asp-validation-for="Description" class="validation-message"></span></div></div><button class="button button--dark" type="submit">Save Product <span>→</span></button></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
